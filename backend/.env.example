# Which data provider serves terrain measurements
EARTH2MOON_DATA_PROVIDER=nasa
# Comma-separated browser origins allowed to call the API
EARTH2MOON_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- AI summaries (optional). Set ONE key; leave all empty to disable. Never commit real keys.
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GEMINI_API_KEY=
# auto | anthropic | openai | gemini | none
EARTH2MOON_AI_PROVIDER=auto
# Claude default: claude-opus-5-5 (claude-haiku-5-5 is much cheaper). Gemini: auto-picks the newest Flash model. Required for OpenAI.
# EARTH2MOON_AI_MODEL=
EARTH2MOON_AI_DAILY_LIMIT=200
