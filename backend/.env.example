# Which data provider serves terrain measurements ("demo" until project datasets are integrated)
EARTH2MOON_DATA_PROVIDER=demo
# Root folder for real datasets (used by future providers)
EARTH2MOON_DATA_DIR=./data
# Comma-separated browser origins allowed to call the API
EARTH2MOON_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
